# Placa: Seeed XIAO ESP32-C3
CONFIG_IDF_TARGET="esp32c3"

# Bluetooth con el stack NimBLE (más ligero que Bluedroid), solo BLE
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# Potencia de transmisión BLE al máximo del C3 (+20 dBm): más alcance para que la oigan 3 nodos.
# Por defecto es +9 dBm. Cuesta algo más de batería (se mide en la prueba de autonomía).
CONFIG_BT_CTRL_DFT_TX_POWER_LEVEL_P20=y

# El XIAO no tiene chip USB-serie: los mensajes salen por el USB nativo del C3
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
