# Bluetooth con el stack NimBLE, solo BLE, en rol observador (escanea)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y

# WiFi y Bluetooth comparten la antena: activar la coexistencia por software
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# WiFi + BLE + HTTP no caben en la partición por defecto (1 MB): usar la de 1.5 MB
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
